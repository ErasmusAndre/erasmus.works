{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Keep cluster-critical infrastructure on manual review",
      "matchPackageNames": [
        "longhorn",
        "cloudnative-pg",
        "volsync",
        "external-secrets",
        "external-dns",
        "snapshot-controller",
        "envoyproxy/gateway-helm",
        "siderolabs/talos",
        "kubernetes/kubernetes",
        "cloudflare/cloudflared",
        "/(^|\\/)(argocd|argo-cd)(\\/|$)/",
        "/(^|\\/)(metallb)(\\/|$)/"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Track Euro-Office v-prefixed tags and treat -hotfix.N as a build component",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/euro-office/documentserver"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-hotfix\\.(?<build>\\d+))?$"
    },
    {
      "description": "Track Umami v3+ plain semver tags, ignoring legacy postgresql-/mysql- prefixed and floating major.minor tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/umami-software/umami"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Talos and Kubernetes upgrade one minor version at a time, so open a separate PR per minor and for patches",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["siderolabs/talos", "kubernetes/kubernetes"],
      "separateMinorPatch": true,
      "separateMultipleMinor": true
    },
    {
      "description": "Wait until Talos and Kubernetes releases are 3 weeks old, so a new minor usually has its first patches by the time the PR opens",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["siderolabs/talos", "kubernetes/kubernetes"],
      "minimumReleaseAge": "21 days"
    },
    {
      "description": "Playwright browser server must match the playwright package inside Open WebUI; bump it by hand with the Open WebUI chart",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcr.microsoft.com/playwright"],
      "enabled": false
    },
    {
      "description": "SearXNG tags are YYYY.M.D-<commit>; compare the date, ignore the commit",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>[0-9a-f]+)$"
    }
  ]
}
